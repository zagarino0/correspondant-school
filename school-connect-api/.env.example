NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Local Docker PostgreSQL
DATABASE_URL=postgresql://schoolconnect:schoolconnect@localhost:5433/school_connect?schema=public

# Use a long random value in staging/production (minimum 32 characters)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated origins for web clients. Use * only for local development.
CORS_ORIGIN=*

LOG_LEVEL=info

LLM_PROVIDER=stub
# LLM_API_KEY=
# LLM_MODEL=
LLM_TIMEOUT_MS=30000


# SMS delivery
SMS_ENABLED=false
SMS_PROVIDER=stub
SMS_MAX_ATTEMPTS=3
SMS_RETRY_BASE_DELAY_MS=30000
SMS_WORKER_INTERVAL_MS=15000

# Twilio (required only when SMS_PROVIDER=twilio and SMS_ENABLED=true)
# Prefer API Key + API Secret in production.
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY=
# TWILIO_API_SECRET=
# TWILIO_AUTH_TOKEN=
# Use either a Twilio sender number or a Messaging Service.
# TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=
