generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  PARENT
  STUDENT
  STAFF
}

enum StaffFunction {
  ADMINISTRATION
  SURVEILLANT
  SECRETARIAT
  COMPTABILITE
  INFIRMIER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
}

enum AcademicYearStatus {
  ACTIVE
  CLOSED
}

enum StudentEnrollmentStatus {
  ACTIVE
  PROMOTED
  REPEATING
  TRANSFERRED
  WITHDRAWN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AssignmentStatus {
  PENDING
  SUBMITTED
  LATE
  COMPLETED
}

enum ScheduleDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AnnouncementAudience {
  STUDENTS
  PARENTS
  TEACHERS
}

model School {
  id     String       @id @default(cuid())
  code   String       @unique
  name   String
  status SchoolStatus @default(ACTIVE)

  users            User[]
  students         Student[]
  academicYears    AcademicYear[]
  classes          SchoolClass[]
  staffAssignments StaffAssignment[]
  schedules        Schedule[]
  announcements   Announcement[]
  conversations   Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id       String  @id @default(cuid())
  schoolId String?

  email        String @unique
  passwordHash String

  firstName String
  lastName  String

  role   UserRole   @default(PARENT)
  status UserStatus @default(ACTIVE)

  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  studentProfile Student?

  staffProfile StaffProfile?

  parentLinks ParentStudent[] @relation("ParentLinks")

  teacherClassAssignments TeacherClass[] @relation("TeacherClassAssignments")

  recordedGrades     Grade[]      @relation("GradeRecordedBy")
  createdAssignments Assignment[] @relation("AssignmentCreatedBy")
  schedules          Schedule[]

  refreshTokens       RefreshToken[]
  recordedAttendances Attendance[]   @relation("AttendanceRecordedBy")
  createdAnnouncements Announcement[] @relation("AnnouncementCreatedBy")
  announcementRecipients AnnouncementRecipient[]
  conversationParticipants ConversationParticipant[]
  sentMessages              Message[] @relation("MessageSender")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([role])
  @@index([status])
}

model AcademicYear {
  id       String @id @default(cuid())
  schoolId String

  name      String
  startDate DateTime
  endDate   DateTime
  status    AcademicYearStatus @default(ACTIVE)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  classes     SchoolClass[]
  enrollments StudentEnrollment[]
  schedules   Schedule[]
  announcements Announcement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([status])
}

model SchoolClass {
  id             String @id @default(cuid())
  schoolId       String
  academicYearId String

  name  String
  level String?

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  teacherAssignments TeacherClass[]
  enrollments        StudentEnrollment[]
  assignments        Assignment[]
  schedules          Schedule[]
  announcementTargets AnnouncementClass[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYearId, name])
  @@index([schoolId])
  @@index([academicYearId])
}

model TeacherClass {
  id        String @id @default(cuid())
  teacherId String
  classId   String

  teacher User        @relation("TeacherClassAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  class   SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, classId])
  @@index([teacherId])
  @@index([classId])
}

model Student {
  id       String @id @default(cuid())
  schoolId String
  userId   String @unique

  // Matricule officiel fourni par l'école.
  // Il est permanent pour l'identité de l'étudiant.
  studentNumber String

  firstName String
  lastName  String

  dateOfBirth DateTime?
  status      UserStatus @default(ACTIVE)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  parents     ParentStudent[]
  enrollments StudentEnrollment[]
  attendances Attendance[]

  grades      Grade[]
  assignments Assignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, studentNumber])
  @@index([schoolId])
  @@index([lastName, firstName])
}

model StudentEnrollment {
  id             String @id @default(cuid())
  studentId      String
  academicYearId String
  classId        String

  status StudentEnrollmentStatus @default(ACTIVE)

  enrolledAt DateTime  @default(now())
  endedAt    DateTime?

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class        SchoolClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendances  Attendance[]

  grades Grade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Un étudiant possède une seule affectation
  // principale par année scolaire.
  @@unique([studentId, academicYearId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([classId])
  @@index([status])
}

model Attendance {
  id           String           @id @default(cuid())
  studentId    String
  enrollmentId String
  date         DateTime
  status       AttendanceStatus @default(PRESENT)
  arrivalTime  DateTime?
  reason       String?
  note         String?
  recordedBy   String

  student    Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  recorder   User              @relation("AttendanceRecordedBy", fields: [recordedBy], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrollmentId, date])
  @@index([studentId])
  @@index([enrollmentId])
  @@index([date])
  @@index([status])
  @@index([recordedBy])
}

model ParentStudent {
  id        String @id @default(cuid())
  parentId  String
  studentId String

  relationship String?
  isPrimary    Boolean @default(false)

  parent  User    @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
}

model StaffProfile {
  id     String @id @default(cuid())
  userId String @unique

  function StaffFunction

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignments StaffAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([function])
}

model StaffAssignment {
  id       String @id @default(cuid())
  staffId  String
  schoolId String

  startDate DateTime
  endDate   DateTime?
  active    Boolean   @default(true)

  staff  StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  school School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, schoolId, startDate])
  @@index([staffId])
  @@index([schoolId])
  @@index([active])
}

model Grade {
  id String @id @default(cuid())

  studentId    String
  enrollmentId String

  subject String
  title   String

  value       Float
  maxValue    Float @default(20)
  coefficient Float @default(1)

  evaluationDate DateTime

  comment String?

  recordedBy String

  student    Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  recorder   User              @relation("GradeRecordedBy", fields: [recordedBy], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([enrollmentId])
  @@index([subject])
  @@index([evaluationDate])
  @@index([recordedBy])
}

model Assignment {
  id String @id @default(cuid())

  studentId String?
  classId   String

  subject     String
  title       String
  description String?

  assignedAt DateTime
  dueDate    DateTime?

  status AssignmentStatus @default(PENDING)

  createdBy String

  student Student?    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  creator User        @relation("AssignmentCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([classId])
  @@index([subject])
  @@index([dueDate])
  @@index([status])
  @@index([createdBy])
}

model Schedule {
  id String @id @default(cuid())

  schoolId       String
  academicYearId String
  classId        String
  teacherId      String

  subject   String
  dayOfWeek ScheduleDay

  startTime String
  endTime   String

  room String?

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class        SchoolClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher      User         @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([academicYearId])
  @@index([classId])
  @@index([teacherId])
  @@index([dayOfWeek])
  @@index([room])
}

model Announcement {
  id             String @id @default(cuid())
  schoolId       String
  academicYearId String
  createdBy      String

  title   String
  content String
  audiences AnnouncementAudience[]

  deletedAt DateTime?

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  creator      User         @relation("AnnouncementCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  classTargets AnnouncementClass[]
  recipients   AnnouncementRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([academicYearId])
  @@index([createdBy])
  @@index([deletedAt])
}

model AnnouncementClass {
  id             String @id @default(cuid())
  announcementId String
  classId       String

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  class        SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([announcementId, classId])
  @@index([announcementId])
  @@index([classId])
}

model AnnouncementRecipient {
  id             String @id @default(cuid())
  announcementId String
  userId         String

  isRead Boolean   @default(false)
  readAt DateTime?

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([announcementId, userId])
  @@index([announcementId])
  @@index([userId])
  @@index([isRead])
}

model Conversation {
  id       String @id @default(cuid())
  schoolId String

  school       School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model ConversationParticipant {
  id             String @id @default(cuid())
  conversationId String
  userId         String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String @id @default(cuid())
  conversationId String
  senderId       String

  content String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model RefreshToken {
  id     String @id @default(cuid())
  userId String

  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  
}
