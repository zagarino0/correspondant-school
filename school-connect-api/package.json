{
  "name": "school-connect-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "prisma generate && vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma generate && prisma db seed",
    "prisma:seed:verify": "prisma generate && tsx prisma/seed-verify.ts",
    "prisma:studio": "prisma studio",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "postinstall": "prisma skills sync || exit 0",
    "test:surveillant-school-life": "tsx scripts/test-surveillant-school-life.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.5",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "crypto": "^1.0.1",
    "fastify": "^5.12.4",
    "openai": "^6.33.0",
    "zod": "^4.6.2",
    "@fastify/websocket": "^11.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "@types/ws": "^8.18.1"
  }
}
